# ── Secrets — never commit real env files or key stashes ───────────────
# Ignore EVERY env file everywhere, then re-allow only the safe, non-secret ones
# (a template, and the frontend's public VITE build config).
.env
*.env
.env.*
*.env.*
!.env.example
!.env.production
BTB_AI/BTB_API_Key
*.pem
*.p12
*.key

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ── Node / Vite ────────────────────────────────────────────────────────
node_modules/
dist/
dist.new/
dist.old/
*.local

# ── RAG / generated data artifacts ─────────────────────────────────────
BTB_AI/vectorstore/

# ── Large media & recordings (use YouTube; keep them out of git) ───────
*.mp4
*.mov
*.wav
*.m4a
BTB_Clips/
BTB_Prepare/**/clips/

# ── Generated transcripts (the site ships BTB_Website/src/data/transcripts/) ──
BTB_Prepare/**/*.diarized.json
BTB_Prepare/**/*.diarized.txt
BTB_Prepare/**/*.timestamped.txt
BTB_Prepare/**/*.json
BTB_Prepare/descript_*_result.json

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
